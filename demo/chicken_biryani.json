{
  "id": "DEMO-03",
  "dish": "chicken biryani",
  "servings": 4,
  "lines": [
    "500 g chicken, curry cut",
    "2 cups basmati rice",
    "2 tbsp ghee",
    "2 tbsp cooking oil",
    "1/2 cup dahi",
    "2 large onions, thinly sliced",
    "1 tbsp ginger garlic paste",
    "1 tsp red chilli powder",
    "1/2 tsp turmeric powder",
    "1 tsp biryani masala",
    "few mint leaves",
    "salt to taste"
  ]
}
