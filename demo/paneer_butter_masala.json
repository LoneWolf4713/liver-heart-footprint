{
  "id": "DEMO-01",
  "dish": "paneer butter masala",
  "servings": 4,
  "lines": [
    "200 g paneer, cubed",
    "2 tbsp butter",
    "1 tbsp cooking oil",
    "2 large tomatoes, chopped",
    "1 medium onion, finely chopped",
